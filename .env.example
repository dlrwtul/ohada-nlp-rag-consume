# Token Hugging Face (optionnel mais recommandé pour éviter le rate-limit)
HF_TOKEN=

# Serveur Ollama (LLM de génération, exécuté localement sur CPU)
OLLAMA_HOST=http://localhost:11434
# mistral (Mistral-7B-Instruct, Apache-2.0) : mêmes poids que le notebook GPU
# (mistral-community/Mistral-7B-Instruct-v0.3), qui donne de bonnes réponses
# sur Colab — c'est le modèle par défaut ici pour avoir une config locale
# équivalente. Plus lourd/lent que qwen2.5:1.5b sur CPU (~4,1 Go, génération
# plus lente) : si la vitesse prime sur la qualité, passer à qwen2.5:1.5b
# (Apache-2.0 aussi). qwen2.5:3b répond un peu mieux que qwen2.5:1.5b mais est
# sous licence Qwen Research (non-commerciale, pas open-source) : à éviter si
# la licence du modèle compte (ex. règlement d'un concours exigeant des LLM
# open-source).
OLLAMA_MODEL=mistral

# Durée pendant laquelle Ollama garde le modèle chargé en RAM après la
# dernière question (évite de le recharger depuis le disque à chaque
# interaction si on attend entre deux messages). "-1" = ne jamais décharger.
OLLAMA_KEEP_ALIVE=30m

# Modèle d'embeddings pour le retrieval. Multilingue (le corpus et les
# questions sont en français) — bge-small-en-v1.5 (anglais uniquement)
# donnait une recherche sémantique dégradée, donc des réponses à côté.
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Dataset source (HF Hub), utilisé seulement si DATASET_XLSX_PATH n'existe pas
DATASET_NAME=uriel/Maathis_Ohada_dataset

# Fichier xlsx local (prioritaire sur DATASET_NAME s'il existe) — voir data/ohada.xlsx
DATASET_XLSX_PATH=./data/ohada.xlsx

# Dossier de persistance de l'index Chroma. _v2 = passage au chunking
# (RecursiveCharacterTextSplitter) ; _v3 = passage à un modèle d'embeddings
# multilingue (voir EMBEDDING_MODEL) — dans les deux cas, un ancien index
# construit avec la config précédente n'est pas compatible, d'où le nom
# différent à chaque fois pour forcer une reconstruction propre.
CHROMA_DIR=./chroma_db_v3

# Base SQLite (comptes utilisateurs, invités, conversations, messages)
APP_DB_PATH=./app.db

# Clé de signature des cookies de session. À fixer avec une valeur aléatoire
# stable en déploiement persistant (sinon une clé éphémère est générée à
# chaque démarrage et toutes les sessions/invités sont perdus au redémarrage) :
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Passer à true uniquement si l'app est servie derrière HTTPS (sinon le
# cookie de session ne sera jamais envoyé et personne ne pourra rester connecté).
SESSION_HTTPS_ONLY=false

# Serveur
HOST=0.0.0.0
PORT=8000
