# Token Hugging Face (optionnel mais recommandé pour éviter le rate-limit)
HF_TOKEN=

# Serveur Ollama (LLM de génération, exécuté localement sur CPU)
OLLAMA_HOST=http://localhost:11434
# qwen2.5:1.5b est sous licence Apache-2.0 (open-source). qwen2.5:3b répond
# un peu mieux mais est sous licence Qwen Research (non-commerciale, pas
# considérée open-source) : à éviter si la licence du modèle compte
# (ex. règlement d'un concours exigeant des LLM open-source).
OLLAMA_MODEL=qwen2.5:1.5b

# Durée pendant laquelle Ollama garde le modèle chargé en RAM après la
# dernière question (évite de le recharger depuis le disque à chaque
# interaction si on attend entre deux messages). "-1" = ne jamais décharger.
OLLAMA_KEEP_ALIVE=30m

# Modèle d'embeddings pour le retrieval
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Dataset source (HF Hub), utilisé seulement si DATASET_XLSX_PATH n'existe pas
DATASET_NAME=uriel/Maathis_Ohada_dataset

# Fichier xlsx local (prioritaire sur DATASET_NAME s'il existe) — voir data/ohada.xlsx
DATASET_XLSX_PATH=./data/ohada.xlsx

# Dossier de persistance de l'index Chroma. Le suffixe _v2 correspond au
# passage au chunking des documents (RecursiveCharacterTextSplitter) : un
# ancien index construit avant (un vecteur par document entier) n'est pas
# compatible, d'où ce nouveau nom qui force une reconstruction propre.
CHROMA_DIR=./chroma_db_v2

# Base SQLite (comptes utilisateurs, invités, conversations, messages)
APP_DB_PATH=./app.db

# Clé de signature des cookies de session. À fixer avec une valeur aléatoire
# stable en déploiement persistant (sinon une clé éphémère est générée à
# chaque démarrage et toutes les sessions/invités sont perdus au redémarrage) :
#   python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# Passer à true uniquement si l'app est servie derrière HTTPS (sinon le
# cookie de session ne sera jamais envoyé et personne ne pourra rester connecté).
SESSION_HTTPS_ONLY=false

# Serveur
HOST=0.0.0.0
PORT=8000
